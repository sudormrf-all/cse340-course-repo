<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <section class="detail-card">
        <h2>Your Account</h2>
        <p><strong>Name:</strong> <%= name %></p>
        <p><strong>Username:</strong> <%= email %></p>
        <p><strong>Role:</strong> <span class="role-badge role-<%= roleName %>"><%= roleName %></span></p>

        <% if (user && user.role_name === 'admin') { %>
        <h3>Admin Tools</h3>
        <p class="page-actions"><a class="button" href="/users">View All Registered Users</a></p>
        <% } %>
    </section>

    <section class="detail-card">
        <h2>My Volunteer Projects</h2>
        <% if (volunteerProjects.length > 0) { %>
        <p>You have signed up to volunteer for <%= volunteerProjects.length %> <%= volunteerProjects.length === 1 ? 'project' : 'projects' %>.</p>
        <ul class="volunteer-list">
            <% volunteerProjects.forEach(project => { %>
            <li>
                <div>
                    <a class="volunteer-project-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
                    <p>
                        <%= project.date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>
                        &middot;
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                        &middot;
                        <%= project.location %>
                    </p>
                </div>
                <form action="/remove-volunteer/<%= project.project_id %>" method="POST">
                    <input type="hidden" name="returnTo" value="dashboard">
                    <button type="submit" class="button button-secondary" aria-label="Remove me as a volunteer for <%= project.title %>">Remove</button>
                </form>
            </li>
            <% }) %>
        </ul>
        <% } else { %>
        <p>You haven't signed up to volunteer for any projects yet. Open a project's page and choose "Volunteer for this project" to sign up.</p>
        <p class="page-actions"><a class="button" href="/projects">Browse Service Projects</a></p>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>
