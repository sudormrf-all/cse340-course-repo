<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <form class="form-card" action="/new-category" method="POST">
        <div class="form-field">
            <label for="name">Category Name</label>
            <input type="text" id="name" name="name" maxlength="100" required aria-describedby="name-hint">
            <p class="hint" id="name-hint">3 to 100 characters. Each category needs a different name.</p>
        </div>

        <div class="form-actions">
            <button type="submit" class="button">Create Category</button>
            <a href="/categories">Cancel</a>
        </div>
    </form>
</main>
<%- include('partials/footer') %>
