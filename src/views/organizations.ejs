<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
<ul class="card-grid org-list">
    <% organizations.forEach(org => { %>
    <li>
        <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
        <strong><a href="/organization/<%= org.organization_id %>"><%= org.name %></a></strong>
        <p><%= org.description %></p>
        <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a>
    </li>
    <% }) %>
</ul>
</main>
<%- include('partials/footer') %>
