<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <a class="site-name" href="/">CSE 340 Service Network</a>
        <nav aria-label="Main navigation">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
            </ul>
        </nav>
    </header>
    <%
        // Show any flash messages (reading them also clears them)
        const messages = typeof locals.flash === 'function' ? locals.flash() : {};
        const messageTypes = Object.keys(messages).filter(type => messages[type].length > 0);
    %>
    <% if (messageTypes.length > 0) { %>
    <div class="flash-messages">
        <% messageTypes.forEach(type => { %>
        <div class="alert <%= type %>" role="<%= type === 'error' ? 'alert' : 'status' %>">
            <% messages[type].forEach(message => { %>
            <p><%= message %></p>
            <% }) %>
        </div>
        <% }) %>
    </div>
    <% } %>
