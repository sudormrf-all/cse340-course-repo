<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <section class="detail-card">
        <h2><%= organizationDetails.name %></h2>
        <img class="detail-logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        <p><%= organizationDetails.description %></p>
        <p><strong>Contact:</strong> <a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a></p>

        <h3>Service Projects</h3>
        <% if (projects.length > 0) { %>
        <ul class="link-list">
            <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }) %>
        </ul>
        <% } else { %>
        <p>This organization has no service projects yet.</p>
        <% } %>
    </section>
    <p><a href="/organizations">&larr; Back to all organizations</a></p>
</main>
<%- include('partials/footer') %>
