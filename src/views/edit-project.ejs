<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <form class="form-card" action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-field">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" maxlength="150" required aria-describedby="title-hint">
            <p class="hint" id="title-hint">3 to 150 characters.</p>
        </div>

        <div class="form-field">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="5" maxlength="1000" required aria-describedby="description-hint"><%= project.description %></textarea>
            <p class="hint" id="description-hint">Up to 1000 characters.</p>
        </div>

        <div class="form-field">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="255" required>
        </div>

        <div class="form-field">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= projectDate %>" required>
        </div>

        <div class="form-field">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>><%= org.name %></option>
                <% }) %>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="button">Update Project</button>
            <a href="/project/<%= project.project_id %>">Cancel</a>
        </div>
    </form>
</main>
<%- include('partials/footer') %>
