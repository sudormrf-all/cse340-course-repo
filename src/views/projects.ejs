<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <% if (projects.length > 0) { %>
    <ul class="card-list project-list">
        <% projects.forEach(project => { %>
        <li>
            <h2>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
            </h2>
            <p>
                <%= project.date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>
                &middot;
                <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
            </p>
            <p><%= project.description %></p>
            <p><strong>Location:</strong> <%= project.location %></p>
        </li>
        <% }) %>
    </ul>
    <% } else { %>
    <p>There are no upcoming service projects right now. Please check back soon.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
