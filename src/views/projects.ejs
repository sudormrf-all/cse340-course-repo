<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
<ul class="card-list">
    <% projects.forEach(project => { %>
    <li>
        <%= project.project_date.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>:
        <%= project.title %> (<%= project.organization_name %>)
    </li>
    <% }) %>
</ul>
</main>
<%- include('partials/footer') %>
