<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <section class="detail-card">
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <p><strong>Date:</strong> <%= project.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    </section>
    <p><a href="/projects">&larr; Back to upcoming projects</a></p>
</main>
<%- include('partials/footer') %>
