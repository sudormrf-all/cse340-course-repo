<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>
    <section class="detail-card">
        <h2><%= categoryDetails.name %></h2>

        <h3>Service Projects</h3>
        <% if (projects.length > 0) { %>
        <ul class="link-list">
            <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }) %>
        </ul>
        <% } else { %>
        <p>There are no service projects in this category yet.</p>
        <% } %>
    </section>
    <p><a href="/categories">&larr; Back to all categories</a></p>
</main>
<%- include('partials/footer') %>
